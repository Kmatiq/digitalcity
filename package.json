{
  "name": "stadsplattan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "pipeline:terrain": "tsx pipeline/build-terrain.ts",
    "pipeline:water": "tsx pipeline/build-water.ts",
    "shots": "node scripts/screenshots.mjs",
    "pipeline:transit": "tsx pipeline/build-transit.ts",
    "pipeline:terrain-wcs": "tsx pipeline/build-terrain-wcs.ts",
    "pipeline:buildings-gbg": "tsx pipeline/build-buildings-gbg.ts"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.4",
    "mqtt": "^5.16.1",
    "proj4": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geotiff": "^3.0.5",
    "globals": "^17.14.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
